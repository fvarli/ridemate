<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug-only overlay.
         The manifest merger folds these attributes into the application
         element declared in src/main, and only for the debug variant — so
         release and profile builds never see this reference and keep
         Android's default of denying cleartext everywhere.
         src/main deliberately declares neither networkSecurityConfig nor
         usesCleartextTraffic, so nothing is being overridden here and no
         tools:replace is required. See res/xml/network_security_config.xml
         for what the exception actually covers.
    -->
    <application
        android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
