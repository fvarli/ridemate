# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Golden test failure artifacts. Regenerated on every failing run; never source.
test/golden/failures/

# Release signing material — NEVER commit. android/.gitignore covers these
# under android/ only; these patterns catch a keystore left anywhere else.
# Deliberately NOT ignored: *.pem, *.crt, *.cer — those are usually public
# certificates, and hiding them would conceal real files rather than secrets.
key.properties
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
